# Prisma Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/fieldservice"

# JWT Secret for authentication
# WARNING: Change this to a strong secret in production
JWT_SECRET="your-secret-key-here"

# Server configuration
PORT=3000
HOST=0.0.0.0

# Base URL for public file URLs (used for uploaded files)
# Set to your production URL with https (e.g., https://yourdomain.com)
BASE_URL="http://localhost:3000"

# CORS Configuration
# Set to specific domain in production (e.g., https://yourdomain.com)
CORS_ORIGIN=true
